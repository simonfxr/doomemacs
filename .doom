;; -*- mode: lisp-data -*-
"3.0.0"
((name . doomemacs/core)
 (version . "2.2.2")
 (homepage . "https://doomemacs.org")

 (commits (style doom) (scopes "cli" "lib" "docs"))

 (make
  ("LICENSE"
   (lambda (_)
     (insert-file-contents (dir! "LICENSE"))
     (and (re-search-forward "(c) 2014-\\(20[0-9]\\{2\\}\\) Henrik")
          (replace-match (format-time-string "%Y") t t nil 1))))))
